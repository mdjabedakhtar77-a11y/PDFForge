# PDFForge Backend Environment Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (MySQL 8.0)
# Leave DB_HOST unset or empty to run in zero-config in-memory mode
DB_HOST=localhost
DB_PORT=3306
DB_USER=pdfforge_user
DB_PASSWORD=pdfforge_secure_pass_2026
DB_NAME=pdfforge

# Authentication & Security
JWT_SECRET=pdfforge_production_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# File Storage & Limits
MAX_FILE_SIZE_MB=50
TEMP_FILE_EXPIRY_HOURS=24
UPLOAD_DIR=

# CORS Origin (comma-separated or * for public APIs)
CORS_ORIGIN=*

# Path to Frontend build/assets (if serving unified from this server)
FRONTEND_DIR=../frontend
