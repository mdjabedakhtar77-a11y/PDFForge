# ==============================================================================
# PDFForge Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Environment & Networking
# ------------------------------------------------------------------------------
# Application listening port
PORT=3000

# Environment mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Permitted CORS origins: '*' or comma-separated domains (e.g. 'https://pdfforge.com,https://api.pdfforge.com')
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# Database Configuration (MySQL 8.0)
# (When running in development without MySQL, PDFForge falls back to an in-memory database)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pdfforge

# MySQL Root Password (used by docker-compose)
MYSQL_ROOT_PASSWORD=pdfforge_root_secret_2026

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens (JWT)
# IMPORTANT: In production, generate a secure random string of at least 64 characters
JWT_SECRET=pdfforge_jwt_secret_key_change_in_production_2026

# JWT token expiration timeframe
JWT_EXPIRES_IN=7d

# Rate limiting limits (requests per window)
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_API_MAX=300

# ------------------------------------------------------------------------------
# Storage, Upload Limits & Retention
# ------------------------------------------------------------------------------
# Maximum allowed file upload size in Megabytes (default: 50MB)
MAX_FILE_SIZE_MB=50

# Automated temporary file retention threshold in hours (default: 24h)
TEMP_FILE_EXPIRY_HOURS=24
